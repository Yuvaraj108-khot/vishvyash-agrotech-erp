generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String
  name              String
  role              String             @default("STAFF")
  phone             String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auditLogs         AuditLog[]
  passwordResetOtps PasswordResetOtp[]

  @@map("users")
}

model Client {
  id            String    @id @default(cuid())
  name          String
  gstNumber     String?
  cinNumber     String?
  address       String
  city          String?
  state         String?   @default("Maharashtra")
  pincode       String?
  phone         String?
  email         String?
  contactPerson String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoices      Invoice[]
  payments      Payment[]

  @@map("clients")
}

model Driver {
  id             String    @id @default(cuid())
  name           String
  phone          String
  alternatePhone String?
  address        String?
  licenseNumber  String?
  aadhaarNumber  String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoices       Invoice[]
  vehicles       Vehicle[]

  @@map("drivers")
}

model Vehicle {
  id              String    @id @default(cuid())
  vehicleNumber   String    @unique
  vehicleType     String?
  ownerName       String?
  driverId        String?
  insuranceExpiry DateTime?
  fitnessExpiry   DateTime?
  permitExpiry    DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invoices        Invoice[]
  driver          Driver?   @relation(fields: [driverId], references: [id])

  @@map("vehicles")
}

model Invoice {
  id                 String        @id @default(cuid())
  invoiceNumber      String        @unique
  invoiceDate        DateTime
  clientId           String
  vehicleId          String?
  driverId           String?
  transportType      String?       @default("By Road")
  buyerName          String
  buyerGst           String?
  buyerCin           String?
  buyerAddress       String?
  buyerState         String?       @default("Maharashtra")
  buyerStateCode     String?       @default("27")
  consigneeName      String?
  consigneeGst       String?
  consigneeAddress   String?
  consigneeState     String?       @default("Maharashtra")
  consigneeStateCode String?       @default("27")
  templateType       String        @default("A")
  subtotal           Float         @default(0)
  transportTotal     Float         @default(0)
  taxableAmount      Float         @default(0)
  cgstRate           Float         @default(2.5)
  sgstRate           Float         @default(2.5)
  cgstAmount         Float         @default(0)
  sgstAmount         Float         @default(0)
  igstRate           Float         @default(0)
  igstAmount         Float         @default(0)
  grandTotal         Float         @default(0)
  amountInWords      String?
  status             String        @default("DRAFT")
  paidAmount         Float         @default(0)
  pdfPath            String?
  notes              String?
  createdBy          String?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  items              InvoiceItem[]
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  driver             Driver?       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle            Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  payments           Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id              String  @id @default(cuid())
  invoiceId       String
  description     String  @default("Biomass Briquettes")
  hsnCode         String  @default("4401")
  quantity        Float
  ratePerTon      Float
  amount          Float
  transportRate   Float   @default(0)
  transportAmount Float   @default(0)
  totalAmount     Float   @default(0)
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  clientId     String
  paymentDate  DateTime
  amount       Float
  paymentMode  String
  chequeNumber String?
  utrNumber    String?
  referenceNo  String?
  bankName     String?
  remarks      String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  userId    String
  otp       String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_otps")
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}
